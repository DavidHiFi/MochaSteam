        "Banner position": "Middle (default)",
        "Big Picture Mode button": "no",
        "Bigger banner": "no",
        "Border radius": "16",
        "Broadcast": "yes",
        "Colour preset": "Custom",
        "Custom font name": "\"Be Vietnam Pro\"",
        "Darken not installed games": "yes",
        "Digital product info": "yes",
        "Dynamic banner height": "yes",
        "Favorite friends status background": "yes",
        "Follow the creators": "yes",
        "Font": "FiraCode Nerd Font",
        "Font weight": "Regular (default)",
        "Footer": "yes",
        "Friend icon": "no",
        "Friend list button": "no",
        "Game Overlay": "yes",
        "Game cover shiny effect": "yes",
        "Game info box artwork": "yes",
        "Hide group chat": "no",
        "Info sidebar on right": "yes",
        "Italic": "no",
